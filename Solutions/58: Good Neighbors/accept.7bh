mem1 = nearest wall
a:
step nw,sw,n,s,ne,se
if nw == datacube or
 ne == datacube or
 se == datacube and
 c == 8 and
 myitem != datacube:
	pickup c
	step mem1
	b:
	if sw == datacube or
	 se == datacube or
	 c == datacube:
		step nw,w,sw,ne,e,se
		jump b
	endif
	drop
endif
jump a