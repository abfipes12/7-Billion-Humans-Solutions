-- 7 Billion Humans (2235) --
-- 22: Number Royale --
-- author: hingston
-- contributor: abfipes
-- notes: abfipes12: "myitem < 63" gives 99.015% success rate instead of 100% (and so undo this too)--
-- time: 7-8

pickup s
a:
if myitem < sw or
 myitem < w or
 myitem < nw or
 myitem < n or
 myitem < ne or
 myitem < e or
 myitem < se or
 myitem < 63:
	b:
	step s
	jump b
endif
step e
jump a