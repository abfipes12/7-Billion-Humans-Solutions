-- 7 Billion Humans (2235) --
-- 22: Number Royale --
-- author: hingston
-- notes: abfipes12: "myitem < 63" gives 99.015% success rate instead of 100% (not allowed) --
-- times: 9.539 9.558 9.418 9.551 9.571 9.763

pickup s
a:
if myitem < sw or
 myitem < w or
 myitem < nw or
 myitem < n or
 myitem < ne or
 myitem < e or
 myitem < se or
 myitem < s:
	b:
	step s
	jump b
endif
step e
jump a