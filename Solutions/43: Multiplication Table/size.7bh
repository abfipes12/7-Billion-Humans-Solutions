-- times: 455 458 426 448

a:
step n,s
if mem1 == 0:
	mem1 = nearest datacube
endif
if c == 0 and mem1 != 0:
	pickup c
	mem2 = calc mem1 + n
	write mem2
	drop
endif
jump a