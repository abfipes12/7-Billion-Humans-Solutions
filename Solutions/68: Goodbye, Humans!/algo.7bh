-- 7 Billion Humans (2214M) --
-- 68: Goodbye, Humans! --
-- author: commonnickname
-- contributor: motlin
-- time: 16.928

jump a
mem1 = foreachdir sw:
	mem2 = foreachdir s:
		mem3 = foreachdir se:
			a:
			jump b
		endfor
	endfor
endfor
b:
if mem2 == nothing:
	step s
	step s
endif
if mem3 == nothing or
 mem1 == nothing:
	step e
	step s
	step s
	jump c
endif
mem4 = set sw
if mem1 == worker and
 mem2 == worker and
 mem3 == worker:
	if mem4 != nothing:
		mem1 = foreachdir nw,n:
		endfor
		mem1 = set myitem
		jump d
		mem1 = foreachdir s:
			d:
			if mem1 == nothing:
				step sw
				jump e
			else:
				mem1 = set c
			endif
		endfor
	endif
	jump f
	mem1 = foreachdir sw:
		mem2 = foreachdir s:
			mem3 = foreachdir se:
				mem4 = foreachdir e:
					f:
					if mem1 == nothing or
					 mem2 == nothing or
					 mem3 == nothing or
					 mem4 == nothing:
						if mem4 == nothing:
							step n
							step e
							step se
							jump g
						else:
							step s
							step s
							step s
							step s
							step s
							if mem1 == nothing:
								step w
							endif
							jump h
						endif
					else:
						mem1 = set sw
						mem2 = set se
						if ne == nothing:
							jump i
						endif
						if s == nothing and
						 ne != wall:
							step s
							if mem1 != nothing:
								step e
							endif
							if mem2 != nothing:
								step e
							endif
							step s
							step s
							jump j
						endif
						jump k
					endif
				endfor
			endfor
		endfor
	endfor
	mem1 = foreachdir nw:
		k:
		if mem1 == worker:
			step s
			step s
			jump l
			mem1 = foreachdir n:
				l:
				if mem1 == nothing:
					step e
					step e
					step e
					step e
					step e
					step s
					jump m
				endif
				if mem4 == nothing:
					jump n
				endif
				step sw
				step n
				step nw
				jump o
			endfor
		endif
		step n
	endfor
	p:
	mem1 = foreachdir w:
		if mem1 != hole:
			step w
			jump p
		endif
	endfor
	step s
	step s
	step s
	step s
	step e
	step s
	jump q
endif
if mem1 == worker and
 mem2 == worker and
 mem3 == wall and
 mem4 == worker:
	jump r
	mem1 = foreachdir s:
		r:
		if mem1 == nothing:
			jump s
		endif
	endfor
	if sw == nothing:
		step sw
		s:
		step s
		jump t
	endif
	if e == wall:
		step sw
		jump u
	else:
		step s
		step s
	endif
endif
if w == nothing:
	step sw
	jump v
endif
if e != wall:
	if mem3 == nothing:
		step w
		step n
		jump x
	endif
	if w == worker and
	 sw == wall and
	 s == worker:
		jump y
	endif
	tell everyone hi
	tell everyone hi
	if nw == hole or
	 w == hole or
	 sw == hole and
	 n == worker:
		step n
		jump z
	endif
	if mem2 == wall and
	 mem3 == wall:
		step n
		jump aa
	endif
	if se != hole:
		mem1 = foreachdir nw,w,sw,n,s,ne,e,se:
			tell everyone hi
		endfor
		if n == hole:
			step se
			jump ab
		endif
		step se
		step s
		step se
		step se
		tell everyone hi
		mem4 = set 0
		tell everyone goodbye
		step se
		step s
	endif
	comment 2
	step sw
	step sw
	jump ac
	comment 1
	ab:
	z:
	o:
	step e
	y:
	x:
	q:
	step e
	n:
	i:
	step e
	jump ad
	comment 0
	aa:
	step w
endif
m:
step w
u:
j:
g:
ac:
step w
v:
t:
h:
c:
step w
e:
ad:
ae:
step s
jump ae


