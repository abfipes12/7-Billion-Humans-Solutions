if sw == hole or
 se == hole:
	pickup s
	if sw == hole:
		step se
		step e
		a:
		step e
		step e
		b:
		step e
		step e
		step e
	else:
		step sw
		step w
		c:
		step w
		step w
		d:
		step w
		step w
		step w
	endif
	drop
endif
if sw != datacube or
 se != datacube:
	pickup s
	if e >= 0:
		step s
		jump a
	endif
	step s
	jump c
endif
if sw != datacube or
 se != datacube:
	pickup s
	if e != worker:
		step s
		jump d
	endif
	step s
	jump b
endif
if sw == datacube:
	pickup sw
endif
pickup se
step s
drop