-- 7 Billion Humans (2235) --
-- 59: Glory Hole --
-- author: commonnickname
-- contributor: motlin
-- time: 6.864

mem1 = nearest datacube
if mem1 != 2:
	if mem1 == 3:
		jump a
	else:
		if mem1 == 4:
			jump b
		else:
			if mem1 == 5:
				jump c
			else:
				if mem1 == 6:
					jump d
				else:
					if mem1 == 10:
						jump e
					else:
						if mem1 == 11:
							jump f
						else:
							jump g
						endif
					endif
				endif
			endif
		endif
	endif
endif
comment 2
step e
jump h
mem1 = foreachdir e:
	h:
	if mem1 == 1:
		step e
		step e
	else:
		jump i
		mem1 = foreachdir ne:
			i:
			if mem1 == 1:
				step ne
				step e
				step n
			else:
				step se
				step se
			endif
		endfor
	endif
endfor
comment 0
mem1 = foreachdir s:
	a:
	if mem1 == datacube:
		step s
		jump j
		mem1 = foreachdir s:
			j:
			if mem1 == 2:
				step s
				step s
				jump k
				mem1 = foreachdir s:
					k:
					if mem1 == hole:
						step sw
						step e
					else:
						step s
						step w
						step w
					endif
				endfor
			else:
				step nw
			endif
		endfor
	else:
		step ne
		step ne
		step n
		step n
	endif
endfor
comment 1
b:
step sw
step sw
step s
step s
step w
step w
comment 3
c:
step nw
step nw
step n
step n
mem1 = foreachdir n:
	if mem1 == 1:
		step ne
		step n
	else:
		if mem1 == 2:
			step ne
			step n
			step e
		else:
			step nw
			step nw
			step w
		endif
	endif
endfor
comment 4
d:
step nw
step nw
step nw
step nw
step nw
step w
step n
comment 5
e:
l:
step sw
m:
step sw
step w
step nw
step nw
step nw
step nw
step w
step w
step w
comment 6
f:
step s
mem1 = nearest datacube
if mem1 == 10:
	jump l
else:
	step se
	step se
	step sw
	step w
	step w
	step nw
	step nw
	step w
	step nw
	step w
	step nw
endif
comment 7
g:
step se
step s
step s
mem1 = nearest datacube
if mem1 == 9:
	jump m
else:
	step sw
	step sw
	step w
	step w
	step w
	step w
	step nw
	step nw
	step nw
	step nw
endif


