-- 7 Billion Humans (2235) --
-- 38: Seek and Destroy 3 --
-- author: donpedro3000
-- time: 17

step n
step n
a:
mem2 = nearest datacube
if mem2 < mem1 or
 mem1 != datacube:
	mem1 = set mem2
endif
step n
mem3 = nearest datacube
if mem2 != mem3:
	b:
	jump a
endif
if n == datacube:
	jump b
endif
pickup mem1
c:
mem2 = nearest worker
if myitem == 0 or
 mem2 == nothing:
	mem3 = nearest shredder
	giveto mem3
endif
if myitem > mem2 and
 mem2 != datacube or
 mem1 != datacube or
 myitem != datacube:
	mem1 = nearest hole
	step mem1
endif
if mem2 == myitem:
	step sw,s,e
endif
jump c
