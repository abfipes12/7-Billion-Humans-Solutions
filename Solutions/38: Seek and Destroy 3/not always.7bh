a:
step nw,w,sw,n,s,ne,e,se
mem2 = nearest datacube
if mem2 < mem1 or
 mem1 != datacube:
	mem1 = nearest datacube
endif
mem3 = nearest worker
if mem3 == worker and
 mem1 != 0:
	jump a
endif
pickup mem1
mem3 = nearest shredder
giveto mem3