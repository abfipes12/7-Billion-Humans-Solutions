a:
step n
if c < mem1 or
 mem1 != datacube:
	mem1 = nearest datacube
endif
if n == datacube:
	jump a
endif
pickup mem1
c:
mem2 = nearest worker
if myitem == 0 or
 mem2 == nothing:
	mem3 = nearest shredder
	giveto mem3
endif
if myitem > mem2 or
 mem1 != datacube or
 myitem != datacube:
	mem1 = nearest hole
	step mem1
endif
if mem2 == myitem:
	step w,sw,s,e,se
endif
jump c
