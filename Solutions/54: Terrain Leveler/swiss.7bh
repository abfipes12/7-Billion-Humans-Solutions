-- times: 78.929 78.971 78.908 78.950 78.881 78.806 78.860 78.908 78.971 78.902 78.971 78.908 78.992 78.950 78.950 78.929 78.929 78.908 78.812 78.812 78.971 78.886 78.929 78.950 78.881 78.886 78.971 78.950 78.971 78.992

a:
step n
if c != datacube:
	jump a
endif
b:
mem1 = calc mem1 + c
if n != datacube:
	if w == datacube:
		listenfor hi
		mem1 = calc mem1 + w
	endif
	pickup c
	write mem1
	tell e hi
	if e == worker:
		mem1 = set e
		listenfor morning
	else:
		mem1 = calc mem1 / 49
	endif
	tell w morning
	c:
	write mem1
	drop
	step s
	pickup c
	jump c
endif
step n
jump b