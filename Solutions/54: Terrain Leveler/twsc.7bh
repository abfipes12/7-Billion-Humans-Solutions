-- times: 77.345 77.387 77.324 77.366 77.297 77.222 77.276 77.324 77.387 77.318 77.387 77.324 77.408 77.366 77.366 77.345 77.345 77.324 77.228 77.228 77.387 77.302 77.345 77.366 77.297 77.302 77.387 77.366 77.387 77.408

a:
step n
if c != datacube:
	jump a
endif
b:
mem1 = calc mem1 + c
if n != datacube:
	if w == datacube:
		listenfor hi
		mem1 = calc mem1 + w
	endif
	pickup c
	write mem1
	tell e hi
	if e == worker:
		mem1 = set e
		listenfor morning
	else:
		mem1 = calc mem1 / 49
	endif
	tell w morning
	c:
	write mem1
	drop
	step s
	pickup c
	jump c
endif
step n
mem1 = calc mem1 + c
step n
jump b