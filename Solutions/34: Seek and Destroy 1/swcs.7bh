-- 7 Billion Humans (2231) --
-- 34: Seek and Destroy 1 --
-- author: n05ucc4u
-- contributor: abfipes
-- time: 15

a:
step n
mem1 = nearest datacube
if mem1 < mem2 or
 mem2 != datacube:
	mem2 = set mem1
endif
if n != wall and
 mem2 != 0:
	jump a
endif
pickup mem2
mem1 = nearest shredder
giveto mem1