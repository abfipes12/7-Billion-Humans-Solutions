mem1 = nearest printer
a:
if e == wall or
 w == wall or
 s == wall or
 sw == datacube or
 se == datacube or
 myitem == nothing and
 c != datacube:
	drop
	takefrom mem1
	step e,w
endif
step nw,ne,sw,se
jump a
