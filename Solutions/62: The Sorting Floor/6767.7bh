-- times: 69.130 71.766 69.274 62.069 71.989 70.179 64.572 65.624 63.694 66.460 64.525 59.204 66.621 62.295 70.924 66.171 69.224 72.132 63.002 65.985 69.852 69.617 71.339 74.109 68.456 68.484 67.692 67.706 63.985 65.274

mem1 = foreachdir nw,w,n,ne,e:
	step n
endfor
if w != hole and
 e != hole:
	a:
	b:
	jump c
	mem1 = foreachdir w:
		mem2 = foreachdir ne:
			mem3 = foreachdir e:
				c:
				mem4 = nearest datacube
				if mem1 > mem4:
					pickup c
					giveto w
					pickup w
					drop
				endif
				if mem4 > mem3:
					pickup c
					giveto e
					pickup e
					drop
				endif
				if mem1 != worker:
					jump b
				endif
				if mem2 > mem1:
					pickup w
					giveto e
					pickup ne
					giveto w
				endif
				if mem2 == hole:
					step s
					step s
				else:
					step n
				endif
			endfor
		endfor
	endfor
	jump a
endif
d:
jump e
mem1 = foreachdir w:
	mem2 = foreachdir n:
		mem3 = foreachdir e:
			e:
			if mem3 != worker and
			 mem1 != worker and
			 myitem != datacube:
				if mem2 == hole:
					step s
					step s
				else:
					step n
				endif
			endif
			if mem2 == nothing:
				step n
			endif
			if myitem == datacube:
				drop
			endif
		endfor
	endfor
endfor
jump d