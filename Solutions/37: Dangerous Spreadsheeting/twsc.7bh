a:
if n != hole and
 ne == hole or
 e == datacube:
	step e
else:
	step se
	if ne == hole:
		step e
	endif
	step ne
	if e == wall and
	 c == 0:
		pickup c
		write mem1
		drop
	endif
endif
mem1 = calc mem1 + c
jump a
