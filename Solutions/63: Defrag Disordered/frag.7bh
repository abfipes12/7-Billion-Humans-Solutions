-- 7 Billion Humans (2231) --
-- 63: Defrag Disordered --
-- author: davidgauch
-- contributor: motlin
-- time: 10.576

mem1 = nearest datacube
pickup mem1
step n
step nw
step n
step n
drop
if myitem == datacube:
	step e
	jump a
endif
step se
pickup s
drop
a:
step e
drop
if myitem != datacube and
 s == nothing:
	step se
	if s != datacube:
		step e
	endif
	pickup s
	step ne
	step n
endif
step n
drop