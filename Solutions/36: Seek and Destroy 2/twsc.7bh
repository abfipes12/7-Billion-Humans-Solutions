mem4 = nearest shredder
a:
step n
mem1 = set n
if mem2 != datacube and
 mem1 == datacube or
 mem1 < mem2 or
 mem1 == wall:
	if mem1 == wall:
		pickup mem2
		giveto mem4
	else:
		mem2 = set mem1
	endif
endif
jump a
