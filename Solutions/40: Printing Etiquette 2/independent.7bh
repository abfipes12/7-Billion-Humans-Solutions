-- 7 Billion Humans (2235) --
-- 40: Printing Etiquette 2 --
-- author: main-gi
-- author: abfipes
-- contributor: motlin
-- times: 73 79
-- notes: main-gi: Independently found, but was not first --

mem1 = nearest printer
a:
if myitem == nothing and
 mem2 < 5:
	mem2 = calc mem2 + 1
	takefrom mem1
	write mem2
endif
step nw,w,sw,ne,e,se
drop
jump a