a:
step w,sw,s,ne,se
drop
if nw == printer or
 ne == printer or
 sw == printer or
 se == printer and
 mem1 < 5 and
 myitem != datacube:
	takefrom nw,sw,ne,se
	mem1 = calc mem1 + 1
	write mem1
endif
jump a