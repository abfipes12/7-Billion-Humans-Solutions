-- 7 Billion Humans (2235) --
-- 40: Printing Etiquette 2 --
-- author: landfillbaby
-- contributor: abfipes
-- time: 51-55

mem1 = nearest printer
jump a
b:
step nw,w,sw,n,ne,e,se
if c == nothing and
 myitem == datacube:
	mem2 = calc mem2 + 1
	write mem2
	drop
	if mem2 < 5:
		a:
		takefrom mem1
	endif
endif
jump b