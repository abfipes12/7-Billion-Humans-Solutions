 mem1 != datacube and
 mem2 != wall:
	step n
	if mem2 < mem1 or
	 mem1 != datacube:
		mem1 = set mem2
	endif
	jump a
endif
pickup mem1
b:
mem2 = nearest worker
if myitem == 0 or
 mem2 == nothing:
	mem3 = nearest shredder
	giveto mem3
endif
if myitem > mem2 and
 mem2 != datacube or
 mem1 != datacube or
 myitem != datacube:
	mem1 = nearest hole
	step mem1
endif
if mem2 == myitem:
	step sw,s
	if s == wall or
	 s == shredder:
		step e
	endif
endif
